# Copy this file to backend/.env and fill in your own values (never commit .env).
# Start locally (from the backend/ folder, with the virtualenv active):
#   uvicorn app.main:app --reload
# API docs: http://localhost:8000/docs

# MySQL connection. mysql://, mysql+pymysql:// and the Railway MYSQL_URL form are all accepted.
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/airport_manager

# Secret used to sign the login tokens (any long random string).
JWT_SECRET=change-me-to-a-long-random-string

# Allowed frontend origins, comma separated.
CORS_ORIGINS=http://localhost:5173

# Optional: freeze "now" for the demo data, which is centered on 2026-11-18 (next flight, upcoming flights, admin stats).
# Leave empty to use the real clock.
APP_NOW=2026-11-18T08:00:00
